HKC_SIM_IMAGE=hkc-sim-collector:robotwin-2.0
HKC_SIM_RUNTIME_ROOT=./runtime
HKC_SIM_GPU=all
HKC_SIM_SHM_SIZE=8gb

# The version-pinning phase will replace or confirm this base image.
ROBOTWIN_BASE_IMAGE=ubuntu:22.04

# Local desktop example. Set these from the active graphical session.
DISPLAY=:1
XAUTHORITY=/run/user/1000/gdm/Xauthority


HKC_SIM_IMAGE=hkc-sim-collector:robotwin-2.0
HKC_CONVERTER_IMAGE=hkc-sim-collector:lerobot-v0.6.2
HKC_SIM_RUNTIME_ROOT=./runtime
HKC_SIM_GPU=all
HKC_SIM_SHM_SIZE=8gb
APP_UID=1000
APP_GID=1000
PIP_INDEX_URL=https://pypi.org/simple
HKC_COLLECT_TIMEOUT_SECONDS=3600

# Immutable multi-architecture manifest digests. The lock file also records
# the expected linux/amd64 child digest.
ROBOTWIN_BASE_IMAGE=nvidia/cuda:12.1.1-devel-ubuntu22.04@sha256:7012e535a47883527d402da998384c30b936140c05e2537158c80b8143ee7425
LEROBOT_BASE_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04@sha256:133c78a0575303be34164d0b90137a042172bdf60696af01a3c424ab402d86e2
LEROBOT_GIT_URL=https://github.com/huggingface/lerobot.git

# Local desktop example. Set these from the active graphical session.
DISPLAY=:1
XAUTHORITY=/run/user/1000/gdm/Xauthority

